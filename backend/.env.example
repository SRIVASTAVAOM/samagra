# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Option A: Single Connection String (Recommended for Cloud Hosting: Neon, Render, Supabase, Railway)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/school_erp_db?sslmode=require

# Option B: Individual Host/Port/User credentials (for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USER=omsrivastava
DB_PASSWORD=
DB_NAME=school_erp_db

# Security & Authentication
JWT_SECRET=super_secret_dev_school_erp_jwt_key_2026_m1
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configuration
# You can provide either CLOUDINARY_URL or CLOUDINARY_CLOUD_NAME + API_KEY + SECRET
# If left empty, backend falls back gracefully to safe local mock simulation
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CLOUDINARY_FOLDER=school_erp
